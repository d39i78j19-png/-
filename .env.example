# ── デスクトップアプリ（Next.js 版）─────────────────────────────
# AI強化機能（企業プロファイル自動抽出・スカウトメール推敲）を使う場合のみ設定
# 未設定でもアプリはルールベースエンジンで全機能動作します
ANTHROPIC_API_KEY=sk-ant-...

# ── ペルソナ顔写真サーバー（standalone/server.js）────────────────
# 顔写真の出し方は2通りあります。
#
#   A) 写真を先に入れておく（推奨・キー不要）
#      http://localhost:8787/photos.html から取り込むだけ。ここは何も設定不要です。
#   B) 都度APIで生成する
#      下のどちらかのキーを設定します。画像モデルに無料枠はありません。
#
# プールに写真があればそちらが優先され、無ければAPIに落ちます（PHOTO_SOURCE=auto）。

GEMINI_API_KEY=                         # https://aistudio.google.com/apikey
OPENAI_API_KEY=                         # GEMINI_API_KEY が無いとき自動で使われます

# 画像まわりの既定値（省略可）
# PHOTO_SOURCE=auto                     # pool=プールのみ / api=都度生成のみ / auto
# PORTRAIT_PROVIDER=auto                # gemini / openai
# PORTRAIT_MODEL=gemini-3-pro-image     # 試行段階は gemini-3.1-flash-image が約半額
# PORTRAIT_SIZE=2K                      # 512 / 1K / 2K / 4K
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high             # low / medium / high
# OPENAI_IMAGE_MODERATION=              # low で人物の誤検知を緩める
# PORTRAIT_WARDROBE=auto                # auto=リクルートスーツ / casual=私服
# PORTRAIT_SCENE=student                # student=大学・就活シーン / office=オフィス
# PORT=8787
